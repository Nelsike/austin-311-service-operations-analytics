	partition fact_requests = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(pProjectFolder & "\data\powerbi\fact_requests.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
					Typed = Table.TransformColumnTypes(Nulls, {{"request_number", type text}, {"source_status", type text}, {"status_class", type text}, {"is_business_duplicate", Int64.Type}, {"is_test", Int64.Type}, {"in_primary", Int64.Type}, {"is_closed", Int64.Type}, {"is_open", Int64.Type}, {"created_date_key", Int64.Type}, {"closed_date_key", Int64.Type}, {"deadline_date_key", Int64.Type}, {"created_local", type datetime}, {"created_utc", type text}, {"closed_local", type datetime}, {"closed_utc", type text}, {"deadline_local", type datetime}, {"deadline_utc", type text}, {"last_updated_local", type datetime}, {"valid_closure", Int64.Type}, {"closure_days", type number}, {"valid_deadline_closure", Int64.Type}, {"closed_by_deadline", Int64.Type}, {"open_age_days", type number}, {"open_past_deadline", Int64.Type}, {"source_is_open", Int64.Type}, {"source_is_closed", Int64.Type}, {"source_is_overdue", Int64.Type}, {"source_closed_on_time", Int64.Type}, {"source_response_days", type number}, {"source_age_days", type number}, {"source_fiscal_year", Int64.Type}, {"status_flag_conflict", Int64.Type}, {"deadline_flag_conflict", Int64.Type}, {"timestamp_ambiguity", Int64.Type}, {"longitude", type number}, {"latitude", type number}, {"service_key", Int64.Type}, {"organization_key", Int64.Type}, {"channel_key", Int64.Type}}, "en-US")
				in
					Typed

