table fact_requests
	lineageTag: f631f63e-235a-5d0a-9794-4b9436c73e64

	measure 'Primary Requests' = COALESCE(CALCULATE(COUNTROWS(fact_requests), KEEPFILTERS(fact_requests[in_primary] = 1)), 0)
		formatString: #,0
		displayFolder: Portfolio metrics
		lineageTag: 56a8dd7a-da3a-57d7-8f60-fc582a26ae81

	measure 'Reported Closed Requests' = CALCULATE([Primary Requests], KEEPFILTERS(fact_requests[is_closed] = 1))
		formatString: #,0
		displayFolder: Portfolio metrics
		lineageTag: 9320a48f-25fa-56ba-a4ac-b55b7b6c27d7

	measure 'Reported Open Backlog' = CALCULATE([Primary Requests], KEEPFILTERS(fact_requests[is_open] = 1))
		formatString: #,0
		displayFolder: Portfolio metrics
		lineageTag: cd02eca5-b509-596a-a189-35694069c904

	measure 'Snapshot Closure Share' = DIVIDE([Reported Closed Requests], [Primary Requests])
		formatString: 0.00%
		displayFolder: Portfolio metrics
		lineageTag: 162272f3-fd65-54e3-a02e-c6e4e2041740

	measure 'Duration Eligible Closed' = CALCULATE([Primary Requests], KEEPFILTERS(fact_requests[valid_closure] = 1))
		formatString: #,0
		displayFolder: Portfolio metrics
		lineageTag: ff24235c-fd01-5e1e-bfad-ff938d2574ca

	measure 'Median Closure Days' =
			MEDIANX(
			    FILTER(fact_requests, fact_requests[in_primary] = 1 && fact_requests[valid_closure] = 1),
			    fact_requests[closure_days]
			)
		formatString: 0.00
		displayFolder: Portfolio metrics
		lineageTag: b9947642-2de2-5fe4-8974-5134306300b7

	measure 'Median Closure Hours' = [Median Closure Days] * 24
		formatString: 0.00
		displayFolder: Portfolio metrics
		lineageTag: 747c83f9-bf2b-57f4-ace1-f82c64300849

	measure 'P90 Closure Days' =
			PERCENTILEX.INC(
			    FILTER(fact_requests, fact_requests[in_primary] = 1 && fact_requests[valid_closure] = 1),
			    fact_requests[closure_days], 0.90
			)
		formatString: 0.00
		displayFolder: Portfolio metrics
		lineageTag: 8312a50a-73f2-5da9-933c-20c44e68b596

	measure 'Deadline Eligible Closed' = CALCULATE([Primary Requests], KEEPFILTERS(fact_requests[valid_deadline_closure] = 1))
		formatString: #,0
		displayFolder: Portfolio metrics
		lineageTag: 8349fa76-15b3-5072-9549-0a69118a9d01

	measure 'Closed By Recorded Deadline' =
			CALCULATE([Primary Requests], KEEPFILTERS(fact_requests[valid_deadline_closure] = 1),
			    KEEPFILTERS(fact_requests[closed_by_deadline] = 1))
		formatString: #,0
		displayFolder: Portfolio metrics
		lineageTag: b54b8a13-e967-5a48-8f72-f8eb87991391

	measure 'Closed By Recorded Deadline Share' = DIVIDE([Closed By Recorded Deadline], [Deadline Eligible Closed])
		formatString: 0.00%
		displayFolder: Portfolio metrics
		lineageTag: c9b9ec5f-c5b9-5266-9d34-2f863c89b221

	measure 'Reported Open Past Deadline' = CALCULATE([Reported Open Backlog], KEEPFILTERS(fact_requests[open_past_deadline] = 1))
		formatString: #,0
		displayFolder: Portfolio metrics
		lineageTag: 35a8bb04-147e-5c13-8686-e7297ce8e031

	measure 'Median Open Age Days' =
			MEDIANX(
			    FILTER(fact_requests, fact_requests[in_primary] = 1 && fact_requests[is_open] = 1 && NOT ISBLANK(fact_requests[open_age_days])),
			    fact_requests[open_age_days]
			)
		formatString: 0.00
		displayFolder: Portfolio metrics
		lineageTag: e53ae5e0-54a0-5c43-a53b-aa28f8c8950e

	measure 'Flag Conflicts In Primary' = CALCULATE([Primary Requests], KEEPFILTERS(fact_requests[status_flag_conflict] = 1))
		formatString: #,0
		displayFolder: Portfolio metrics
		lineageTag: 78e0e7c7-ffb8-5559-af6b-1275a107af3b

	measure 'All Nontest Intake' = COALESCE(CALCULATE(COUNTROWS(fact_requests), KEEPFILTERS(fact_requests[is_test] = 0)), 0)
		formatString: #,0
		displayFolder: Portfolio metrics
		lineageTag: c247617e-4828-5af7-aa15-d0058ea1152a

	measure 'Duplicate Marked Intake' = CALCULATE([All Nontest Intake], KEEPFILTERS(fact_requests[is_business_duplicate] = 1))
		formatString: #,0
		displayFolder: Portfolio metrics
		lineageTag: fab95ff8-51bb-59a9-a3f1-06adbf40c686

	measure 'Duplicate Marked Share' = DIVIDE([Duplicate Marked Intake], [All Nontest Intake])
		formatString: 0.00%
		displayFolder: Portfolio metrics
		lineageTag: 7926f360-6b92-5b40-8c86-e33a1d9005f0

	measure 'Cohort Closures By Closure Month' =
			CALCULATE([Reported Closed Requests],
			    USERELATIONSHIP(dim_date[date_key], fact_requests[closed_date_key]))
		formatString: #,0
		displayFolder: Portfolio metrics
		lineageTag: f1d5e5ae-0670-5702-992e-da79acff718c

	measure 'Snapshot Date' = MAX(snapshot[snapshot_date])
		displayFolder: Portfolio metrics
		lineageTag: d6136da4-68c0-5847-8101-2fd6fdaa485a

	measure 'Scope Label' = "Requests created in 2025 | statuses observed in Nov 7, 2026 export"
		displayFolder: Portfolio metrics
		lineageTag: 8669aac0-4d2c-550f-ae03-bdd64f5f0faa

	measure 'Mean Closure Days' = AVERAGEX(FILTER(fact_requests, fact_requests[in_primary] = 1 && fact_requests[valid_closure] = 1), fact_requests[closure_days])
		formatString: 0.00
		displayFolder: Portfolio metrics
		lineageTag: d3c4c26b-f5c4-56f4-bf21-b5721e8a9b57

	measure 'Oldest Reported Open Age Days' = MAXX(FILTER(fact_requests, fact_requests[in_primary] = 1 && fact_requests[is_open] = 1), fact_requests[open_age_days])
		formatString: 0.00
		displayFolder: Portfolio metrics
		lineageTag: 668a6eb9-13e2-536b-8a5f-72f8cf9fcd6c

	measure 'Ambiguous Timestamps' = CALCULATE([Primary Requests], KEEPFILTERS(fact_requests[timestamp_ambiguity] = 1))
		formatString: #,0
		displayFolder: Portfolio metrics
		lineageTag: 6a202c0c-d2cd-5d55-a035-7e8eddc2ba9d

	measure 'Missing Geography All Intake' = COALESCE(COUNTROWS(FILTER(fact_requests, ISBLANK(fact_requests[latitude]))), 0)
		formatString: #,0
		displayFolder: Portfolio metrics
		lineageTag: 4800c3ca-32fb-5d99-a5b3-16ecb12e65e1

	measure 'Top Eight Intake' = VAR Position = RANKX(ALLSELECTED(dim_service[service_description]), [Primary Requests], , DESC, DENSE) RETURN IF(Position <= 8 && [Primary Requests] > 0, [Primary Requests], BLANK())
		formatString: #,0
		displayFolder: Portfolio metrics
		lineageTag: 88a8d03f-28f6-5e9a-a748-33c656a5566c

	measure 'Open Age By Request' = IF([Reported Open Backlog] > 0, MAX(fact_requests[open_age_days]), BLANK())
		formatString: #,0
		displayFolder: Portfolio metrics
		lineageTag: 72446211-752c-5be3-b2fd-bc01b5c15e4d

